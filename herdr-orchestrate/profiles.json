{
  "defaultProfile": "balanced",
  "agents": {
    "grok": {
      "kind": "cursor",
      "command": ["agent", "--model", "cursor-grok-4.6-high"]
    },
    "openai": {
      "kind": "pi",
      "command": ["pi", "--provider", "openai-codex", "--model", "gpt-5.6-sol", "--thinking", "high"]
    }
  },
  "profiles": {
    "balanced": {
      "description": "Grok implementation; OpenAI for difficult work and independent review.",
      "roles": {
        "implementer": "grok",
        "complex": "openai",
        "reviewer": "openai"
      },
      "maxWorkers": 3,
      "maxHeavyJobs": 1,
      "waitSeconds": 15
    },
    "difficult": {
      "description": "OpenAI throughout, with fewer concurrent workers for complex cross-cutting changes.",
      "roles": {
        "implementer": "openai",
        "complex": "openai",
        "reviewer": "openai"
      },
      "maxWorkers": 2,
      "maxHeavyJobs": 1,
      "waitSeconds": 15
    },
    "grok": {
      "description": "Grok throughout, including a separate reviewer for stable changes.",
      "roles": {
        "implementer": "grok",
        "complex": "grok",
        "reviewer": "grok"
      },
      "maxWorkers": 3,
      "maxHeavyJobs": 1,
      "waitSeconds": 15
    }
  }
}
